# URL pública del sitio (sin barra final). Se usa en canonical, sitemap y Open Graph.
VITE_SITE_URL=https://quintalosgalpones.com
# true en preview: agrega meta noindex y un robots.txt que bloquea todo.
VITE_NOINDEX=true
# Endpoint del Google Apps Script que recibe el formulario (apps-script/Code.gs).
VITE_FORM_ENDPOINT=
# ID de Google Analytics 4 (G-XXXXXXXXXX). Si está vacío, no se carga GA.
VITE_GA_ID=
# Solo preview: muestra piezas que esperan foto real (interruptor Sol/Lluvia) usando la provisoria.
VITE_PREVIEW_PENDING=
