{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/hello-world",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/feed",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/comments/feed",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/wp-sitemap:rest(.*)\\.xml",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:wp(category|author|tag)",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:wp(category|author|tag)/:rest*",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/:wp(wp-admin|wp-login.php|wp-content|wp-includes|wp-json|xmlrpc.php)",
      "destination": "/wp-no-existe"
    },
    {
      "source": "/:wp(wp-admin|wp-content|wp-includes|wp-json)/:rest*",
      "destination": "/wp-no-existe"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?!assets/|photos/|photos-temp/|brand/|og/|map/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(photos-temp|brand|og|map)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
