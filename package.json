{
  "name": "quinta-los-galpones",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "check:tells": "node scripts/check-tells.mjs",
    "test:tells": "node scripts/test-tells.mjs",
    "check:nojs": "node scripts/check-nojs.mjs",
    "check:panel": "node scripts/check-panel.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "measure:tap": "node scripts/measure-tap.mjs",
    "check": "npm run check:content && npm run check:tells && npm run test:tells"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@react-router/node": "^7.18.5",
    "@react-router/serve": "^7.18.5",
    "isbot": "^5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
